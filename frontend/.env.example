# Copy to .env for local development. Never commit .env.

# Optional. Leave unset: the app calls /api-v2.0 on its own origin, which is
# proxied to the backend (Vite dev server locally, vercel.json on Vercel).
# VITE_API_BASE_URL=/api-v2.0

# Stripe publishable key (Dashboard → Developers → API keys). Starts with pk_test_ in test mode.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
